   "source": [
    "# AI Document Chatbot using RAG\n",
    "\n",
    "## Module 4 \u2013 RAG, Embeddings & Vector Databases\n",
    "\n",
    "Pipeline: Document \u2192 Text Extraction \u2192 Chunking \u2192 Embeddings \u2192 FAISS Vector Database \u2192 Retrieval \u2192 LLM \u2192 Answer"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "!pip install -q pypdf sentence-transformers faiss-cpu transformers torch\n",
    "print('Installation completed!')"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "import os\n",
    "import numpy as np\n",
    "import faiss\n",
    "import torch\n",
    "from pypdf import PdfReader\n",
    "from sentence_transformers import SentenceTransformer\n",
    "from transformers import AutoTokenizer, AutoModelForSeq2SeqLM\n",
    "\n",
    "print('Libraries imported successfully!')"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "from google.colab import files\n",
    "\n",
    "uploaded = files.upload()\n",
    "file_name = list(uploaded.keys())[0]\n",
    "\n",
    "print('Uploaded file:', file_name)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "reader = PdfReader(file_name)\n",
    "text = ''\n",
    "\n",
    "for page in reader.pages:\n",
    "    page_text = page.extract_text()\n",
    "    if page_text:\n",
    "        text += page_text + '\\n'\n",
    "\n",
    "print('PDF text extracted successfully!')\n",
    "print('Number of characters:', len(text))\n",
    "print(text[:3000])"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "text = text.replace('\\n', ' ')\n",
    "text = ' '.join(text.split())\n",
    "\n",
    "print('Text cleaned successfully!')\n",
    "print(text[:1000])"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "chunk_size = 500\n",
    "overlap = 100\n",
    "chunks = []\n",
    "start = 0\n",
    "\n",
    "while start < len(text):\n",
    "    end = start + chunk_size\n",
    "    chunk = text[start:end]\n",
    "    if chunk.strip():\n",
    "        chunks.append(chunk)\n",
    "    start += chunk_size - overlap\n",
    "\n",
    "print('Total chunks created:', len(chunks))"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "embedding_model = SentenceTransformer('all-MiniLM-L6-v2')\n",
    "\n",
    "embeddings = embedding_model.encode(\n",
    "    chunks,\n",
    "    convert_to_numpy=True,\n",
    "    show_progress_bar=True\n",
    ")\n",
    "\n",
    "print('Embeddings created successfully!')\n",
    "print('Embedding shape:', embeddings.shape)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "dimension = embeddings.shape[1]\n",
    "index = faiss.IndexFlatL2(dimension)\n",
    "index.add(embeddings.astype('float32'))\n",
    "\n",
    "print('FAISS vector database created!')\n",
    "print('Number of vectors:', index.ntotal)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def retrieve_documents(query, top_k=3):\n",
    "    query_embedding = embedding_model.encode(\n",
    "        [query],\n",
    "        convert_to_numpy=True\n",
    "    )\n",
    "\n",
    "    distances, indices = index.search(\n",
    "        query_embedding.astype('float32'),\n",
    "        top_k\n",
    "    )\n",
    "\n",
    "    results = []\n",
    "    for i in indices[0]:\n",
    "        if i < len(chunks):\n",
    "            results.append(chunks[i])\n",
    "\n",
    "    return results\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "model_name = 'google/flan-t5-small'\n",
    "\n",
    "tokenizer = AutoTokenizer.from_pretrained(model_name)\n",
    "llm = AutoModelForSeq2SeqLM.from_pretrained(model_name)\n\n",
    "print('LLM loaded successfully!')"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def generate_answer(question, top_k=3):\n",
    "    retrieved_chunks = retrieve_documents(question, top_k)\n",
    "    context = '\\n\\n'.join(retrieved_chunks)\n",
    "\n",
    "    prompt = f'''Answer the question using only the information provided in the context.\n",
    "\n",
    "Context:\n",
    "{context}\n",
    "\n",
    "Question:\n",
    "{question}\n",
    "\n",
    "Answer:'''\n",
    "\n",
    "    inputs = tokenizer(\n",
    "        prompt,\n",
    "        return_tensors='pt',\n",
    "        truncation=True,\n",
    "        max_length=512\n",
    "    )\n",
    "\n",
    "    with torch.no_grad():\n",
    "        outputs = llm.generate(\n",
    "            **inputs,\n",
    "            max_new_tokens=100\n",
    "        )\n",
    "\n",
    "    answer = tokenizer.decode(\n",
    "        outputs[0],\n",
    "        skip_special_tokens=True\n",
    "    )\n",
    "\n",
    "    return answer, retrieved_chunks"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "print('AI Document Chatbot')\n",
    "print('Ask questions about your uploaded document.')\n",
    "print(\"Type 'exit' to stop.\\n\")\n",
    "\n",
    "while True:\n",
    "    question = input('You: ').strip()\n",
    "\n",
    "    if question.lower() == 'exit':\n",
    "        print('\\nChatbot stopped.')\n",
    "        break\n",
    "\n",
    "    if not question:\n",
    "        print('Please enter a question.\\n')\n",
    "        continue\n",
    "\n",
    "    try:\n",
    "        answer, sources = generate_answer(question)\n",
    "        print('\\nAI:', answer)\n",
    "        print()\n",
    "    except Exception as e:\n",
    "        print('\\nError:', e)\n",
    "        print('Please try another question.\\n')"
   ]
  },
  {
